{
  "title": "Barista",
  "uid": "barista",
  "tags": ["coffee-shop"],
  "timezone": "browser",
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Turn latency (p50 / p95)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum(rate(agent_turn_duration_milliseconds_bucket[5m])) by (le))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum(rate(agent_turn_duration_milliseconds_bucket[5m])) by (le))", "legendFormat": "p95"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Loop iterations per turn — a model going in circles shows up here first",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(agent_loop_iterations_bucket[5m])) by (le))", "legendFormat": "p95 laps"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool calls by outcome",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum by (tool, ok) (rate(agent_tool_calls_total[5m]))", "legendFormat": "{{tool}} ok={{ok}}"}]
    },
    {
      "type": "stat",
      "title": "Malformed tool calls — the headline quality metric for a 7B",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "targets": [{"expr": "sum(increase(agent_tool_malformed_total[1h]))"}]
    },
    {
      "type": "stat",
      "title": "Guard rejections — should sit at zero",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [{"expr": "sum by (guard) (increase(agent_guard_rejections_total[1h]))", "legendFormat": "{{guard}}"}]
    },
    {
      "type": "timeseries",
      "title": "Tokens in / out",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "sum by (type) (rate(llm_tokens_total[5m]))", "legendFormat": "{{type}}"}]
    },
    {
      "type": "timeseries",
      "title": "Off-menu requests — do they want what we don't sell, or what we sold out of?",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "sum by (kind) (rate(agent_offmenu_request_total[5m]))", "legendFormat": "{{kind}}"}]
    }
  ]
}
