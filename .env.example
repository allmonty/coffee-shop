# Copy to .env to override. Compose reads .env automatically.

# Which model the barista uses. Must support tool calling.
#   qwen2.5:14b-instruct  best rule-following, ~9GB    (default)
#   qwen2.5:7b-instruct   ~2x faster, ~4.7GB, occasionally sloppier
#   qwen2.5:3b            fastest, ~1.9GB, frequently ignores prompt rules
# All three pass scripts/check_tool_calling.py and the scenario suite.
OLLAMA_MODEL=qwen2.5:14b-instruct

# Which model summarizes a finished visit into notes. Summarizing is a different
# job from conversation: no tools, no rules to follow, one short structured
# answer — so it can take a much smaller model than the barista.
#   unset       use OLLAMA_MODEL (default)
#   qwen2.5:3b  plenty for this, and several times faster
# Left unset by default on purpose: summarization never raises, so pointing this
# at a model you have not pulled means notes silently stop being written.
# Pull it first (`ollama pull qwen2.5:3b`), then set it.
# OLLAMA_SUMMARY_MODEL=qwen2.5:3b

# Where the API finds Ollama.
#   host Ollama (default, fastest on Apple Silicon):
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
#   containerised Ollama, with `make up-with-llm`:
# OLLAMA_BASE_URL=http://llm:11434/v1
