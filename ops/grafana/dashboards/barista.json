{
  "title": "Barista",
  "uid": "barista",
  "tags": [
    "coffee-shop"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Turn latency (p50 / p95)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(agent_turn_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_turn_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Loop iterations per turn \u2014 a model going in circles shows up here first",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_loop_iterations_bucket[5m])) by (le))",
          "legendFormat": "p95 laps",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Tool calls by outcome",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (tool, ok) (rate(agent_tool_calls_total[5m]))",
          "legendFormat": "{{tool}} ok={{ok}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Malformed tool calls \u2014 the headline quality metric for a 7B",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(increase(agent_tool_malformed_total[1h]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Guard rejections \u2014 should sit at zero",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (guard) (increase(agent_guard_rejections_total[1h]))",
          "legendFormat": "{{guard}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens in / out",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(llm_tokens_total[5m]))",
          "legendFormat": "{{type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Off-menu requests \u2014 do they want what we don't sell, or what we sold out of?",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(agent_offmenu_request_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "logs",
      "title": "Agent event log \u2014 filter by visit to see a whole day; click trace_id for the turn",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"coffee-shop-api\"} | scope_name = \"coffee_shop.agent\" | visit_id=~\"$visit\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Errors and warnings only \u2014 should stay empty",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"coffee-shop-api\"} | visit_id=~\"$visit\" | severity_text =~ \"WARN.*|ERROR\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "visit",
        "label": "Visit (one in-game day)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [],
        "hide": 0
      }
    ]
  }
}
