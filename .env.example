# Copy to .env to override. Compose reads .env automatically.

# Which model the barista uses. Must support tool calling.
#   qwen2.5:7b-instruct  reliable, ~4.7GB      (default)
#   qwen2.5:3b           faster, less reliable at following prompt rules
OLLAMA_MODEL=qwen2.5:7b-instruct

# Where the API finds Ollama.
#   host Ollama (default, fastest on Apple Silicon):
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
#   containerised Ollama, with `make up-with-llm`:
# OLLAMA_BASE_URL=http://llm:11434/v1
